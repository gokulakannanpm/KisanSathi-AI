# Security & JWT Authentication
# In production, SECRET_KEY is strictly required and must be at least 32 characters.
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_cryptographically_secure_32_char_secret_key_here
ENVIRONMENT=development

# CORS Configuration (comma-separated allowed origins for frontend hosting)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://kisansathi-ai-1-029i.onrender.com

# Database Connection (defaults to SQLite; supports PostgreSQL on Render)
DATABASE_URL=sqlite:///./kisansathi.db

# Weather Provider Configuration (Default: openmeteo, or openweathermap with API key)
WEATHER_API_PROVIDER=openmeteo
OPENWEATHER_API_KEY=

# Government of India OGD AGMARKNET Mandi Price API Key (Data.gov.in)
MANDI_API_KEY=

# AI Assistant / Groq Provider Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

